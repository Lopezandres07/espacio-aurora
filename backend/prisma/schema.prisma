generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  phone     String?
  password  String
  role      Role     @default(CLIENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  appointments Appointment[]
  leads        Lead[]
}

enum Role {
  CLIENT
  ADMIN
}

model Service {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  appointments Appointment[]
  leads        Lead[]
}

model Lead {
  id        String   @id @default(uuid())
  name      String
  userId    String?  // Relación opcional si está logueado
  user      User?    @relation(fields: [userId], references: [id])
  serviceId String?  
  service   Service? @relation(fields: [serviceId], references: [id])
  createdAt DateTime @default(now())
}

model Appointment {
  id          String   @id @default(uuid())
  date        DateTime
  status      AppointmentStatus @default(PENDING)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  serviceId   String
  service     Service  @relation(fields: [serviceId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum AppointmentStatus {
  PENDING
  COMPLETED
  CANCELLED
}
